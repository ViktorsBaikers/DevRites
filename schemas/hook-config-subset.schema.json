{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devrites.dev/schemas/hook-config-subset.schema.json",
  "title": "DevRites hook config subset",
  "type": "object",
  "description": "The small hook surface DevRites writes/merges for project-local Claude/Codex installs.",
  "properties": {
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "matcher": { "type": "string" },
                "hooks": { "type": "array" },
                "command": { "type": "string" }
              },
              "additionalProperties": true
            }
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
