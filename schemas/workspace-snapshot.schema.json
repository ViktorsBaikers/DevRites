{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devrites.dev/schemas/workspace-snapshot.schema.json",
  "title": "DevRites workspace snapshot",
  "type": "object",
  "required": ["schemaVersion", "slug", "phase", "runMode", "complete", "sections", "evidence", "drift", "review", "harness", "extensions", "dirtyWorkspace", "capabilities", "nextCommands"],
  "properties": {
    "schemaVersion": { "const": "devrites.workspace.v1" },
    "slug": { "type": "string" },
    "phase": { "type": "string" },
    "runMode": { "enum": ["HITL", "AFK"] },
    "complete": { "type": "boolean" },
    "sections": { "type": "array", "items": { "$ref": "#/definitions/section" } },
    "missingSections": { "type": "array", "items": { "type": "string" } },
    "currentSlice": { "$ref": "#/definitions/slice" },
    "evidence": { "$ref": "#/definitions/statusDetail" },
    "drift": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" }, "open": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "review": { "$ref": "#/definitions/statusDetail" },
    "harness": { "$ref": "#/definitions/statusDetail" },
    "extensions": { "type": "object", "required": ["status", "count"], "properties": { "status": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "dirtyWorkspace": { "type": "object", "required": ["status", "changed"], "properties": { "status": { "type": "string" }, "changed": { "type": "integer", "minimum": 0 }, "sample": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "capabilities": { "type": "array", "items": { "$ref": "#/definitions/capability" } },
    "nextCommand": { "type": "string" },
    "nextCommands": { "type": "object", "properties": { "verb": { "type": "string" }, "claude": { "type": "string" }, "codex": { "type": "string" } }, "additionalProperties": false },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "definitions": {
    "section": { "type": "object", "required": ["name", "present", "required"], "properties": { "name": { "type": "string" }, "present": { "type": "boolean" }, "required": { "type": "boolean" } }, "additionalProperties": false },
    "slice": { "type": "object", "required": ["index", "total", "state"], "properties": { "index": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 }, "name": { "type": "string" }, "state": { "type": "string" } }, "additionalProperties": false },
    "statusDetail": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" }, "detail": { "type": "string" } }, "additionalProperties": false },
    "capability": { "type": "object", "required": ["name", "status", "usedBy", "fallback", "risk"], "properties": { "name": { "type": "string" }, "status": { "type": "string" }, "usedBy": { "type": "string" }, "fallback": { "type": "string" }, "risk": { "type": "string" } }, "additionalProperties": false }
  }
}
