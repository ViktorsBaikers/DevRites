      "expected": "should_trigger",
      "rationale": "Direct slash invocation."
    },
    {
      "text": "$rite-prototype",
      "expected": "should_trigger",
      "rationale": "Direct Codex invocation."
    },
    {
      "text": "/rite prototype",
      "expected": "should_trigger",
      "rationale": "Menu-style invocation."
    },
    {
