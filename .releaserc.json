{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        { "type": "docs", "scope": "README", "release": "patch" },
        { "type": "refactor", "release": "patch" },
        { "type": "perf", "release": "patch" },
        { "type": "build", "release": "patch" },
        { "type": "remove", "release": "minor" },
        { "breaking": true, "release": "major" },
        { "revert": true, "release": "patch" },
        { "scope": "no-release", "release": false }
      ]
    }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits",
      "presetConfig": {
        "types": [
          { "type": "feat", "section": "Added" },
          { "type": "perf", "section": "Changed" },
          { "type": "refactor", "section": "Changed" },
          { "type": "build", "section": "Changed" },
          { "type": "remove", "section": "Removed" },
          { "type": "fix", "section": "Fixed" },
          { "type": "docs", "section": "Documentation" },
          { "type": "ci", "section": "CI", "hidden": true },
          { "type": "chore", "section": "Chores", "hidden": true },
          { "type": "test", "section": "Tests", "hidden": true }
        ]
      }
    }],
    ["@semantic-release/changelog", {
      "changelogFile": "CHANGELOG.md",
      "changelogTitle": "# Changelog\n\nAll notable changes to DevRites are documented here. The format follows [Keep a Changelog](https://keepachangelog.com/en/1.1.0/) and DevRites adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html). Releases are generated automatically by [semantic-release](https://semantic-release.gitbook.io/) from Conventional Commits on `main`."
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "bash scripts/sync-version.sh ${nextRelease.version} && git add -- CHANGELOG.md README.md package.json && bash scripts/build-release-tarball.sh ${nextRelease.version} && bash scripts/build-binaries.sh ${nextRelease.version}"
    }],
    ["@semantic-release/npm", {
      "npmPublish": true
    }],
    ["@semantic-release/git", {
      "assets": [
        "CHANGELOG.md",
        "README.md",
        "package.json",
        "package-lock.json"
      ],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "dist/devrites-v*.tar.gz", "label": "devrites-v${nextRelease.version}.tar.gz (pack tarball)" },
        { "path": "dist/devrites-v*.tar.gz.sha256", "label": "devrites-v${nextRelease.version}.tar.gz.sha256 (checksum)" },
        { "path": "dist/install.sh", "label": "install.sh (verified release installer)" },
        { "path": "dist/install.sh.sha256", "label": "install.sh.sha256 (checksum)" },
        { "path": "dist/bin/devrites-*-*" }
      ],
      "successComment": false,
      "failComment": false
    }]
  ]
}
