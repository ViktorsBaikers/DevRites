{
  // DevRites website + install endpoint.
  // Static assets in web/ are served directly; a small worker (worker.js) runs
  // only for "/" and "/install.sh" to hand the install script to CLI clients.
  // Production branch on Cloudflare: site/web.
  "name": "devrites",
  "main": "worker.js",
  "compatibility_date": "2026-05-29",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/install.sh"]
  }
}
